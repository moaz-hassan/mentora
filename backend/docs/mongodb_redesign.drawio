;(room + _id cursor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="735" width="260" height="58" as="geometry"/></mxCell><mxCell id="sp665_n1" value="rooms.last_message&#10;+ stats $inc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="420" y="735" width="240" height="58" as="geometry"/></mxCell><mxCell id="sp665_n2" value="participants $inc&#10;unread_count&#10;(!= sender)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="720" y="735" width="240" height="58" as="geometry"/></mxCell><mxCell id="sp665_n3" value="badge: $sum&#10;unread_count&#10;(ONE query)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1020" y="735" width="240" height="58" as="geometry"/></mxCell><mxCell id="sp665_n4" value="mark read -&gt;&#10;unread = 0 +&#10;last_read_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1320" y="735" width="240" height="58" as="geometry"/></mxCell><mxCell id="f26" value="fan-out" style="html=1;rounded=0;strokeColor=#A78BFA;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp665_n0" target="sp665_n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f27" value="increment" style="html=1;rounded=0;strokeColor=#A78BFA;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp665_n1" target="sp665_n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f28" value="badge" style="html=1;rounded=0;strokeColor=#A78BFA;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp665_n2" target="sp665_n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f29" value="reset" style="html=1;rounded=0;strokeColor=#A78BFA;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp665_n3" target="sp665_n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sp840_n0" value="progress reaches 100%&#10;($addToSet lessons)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="910" width="260" height="58" as="geometry"/></mxCell><mxCell id="sp840_n1" value="transaction:&#10;enrollment -&gt; completed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="420" y="910" width="240" height="58" as="geometry"/></mxCell><mxCell id="sp840_n2" value="certificates issue&#10;(UQ student+course,&#10;serial for verify)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="720" y="910" width="260" height="58" as="geometry"/></mxCell><mxCell id="sp840_n3" value="courses.stats.&#10;completion_count $inc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1040" y="910" width="250" height="58" as="geometry"/></mxCell><mxCell id="sp840_n4" value="notification + stored&#10;PDF link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1350" y="910" width="240" height="58" as="geometry"/></mxCell><mxCell id="f2b" value="checkpoint" style="html=1;rounded=0;strokeColor=#FBBF24;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp840_n0" target="sp840_n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2c" value="issue" style="html=1;rounded=0;strokeColor=#FBBF24;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp840_n1" target="sp840_n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2d" value="count" style="html=1;rounded=0;strokeColor=#FBBF24;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp840_n2" target="sp840_n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2e" value="alert" style="html=1;rounded=0;strokeColor=#FBBF24;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp840_n3" target="sp840_n4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
