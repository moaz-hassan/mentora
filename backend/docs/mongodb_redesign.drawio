<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="Mentora DB Redesign Generator" version="24.7.9" type="device">
<diagram id="p1-cover" name="1. Cover &amp; Legend">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1160" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cv_banner" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;MENTORA — MongoDB Data-Layer Redesign&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;Greenfield data model · 26 collections · 7 domains · MongoDB-native (zero SQL thinking) · proposal v1 for owner approval&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1580" height="80" as="geometry"/></mxCell><mxCell id="cv_legend" value="&lt;b style='color:#3B82F6;font-size:13px;'&gt;LEGEND — colors, markers, notation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#3B82F6;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="1050" height="340" as="geometry"/></mxCell><mxCell id="cv_meta" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Scope &amp; Status&lt;/b&gt;&amp;#10;status    : PROPOSAL v1 - awaiting owner approval&#10;decisions : DP-01 .. DP-20  (doc section 9)&#10;scope     : DB layer only - collections, schemas,&#10;            indexes, integrity rules, read model&#10;data      : greenfield - no migration of old data&#10;engine    : MongoDB - no relational patterns&#10;api       : flexible - frontend follows the redesign&#10;code      : paused - nothing built until decisions&#10;source    : docs/MONGODB_REDESIGN.md @ 632dac6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="480" height="240" as="geometry"/></mxCell><mxCell id="cv_changed" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;What Changed vs Today&lt;/b&gt;&amp;#10;collections  30  -&gt;  26&#10;removed (9): profiles, chapters, lessons,&#10;  sub_categories, featured_courses,&#10;  notification_logs, enrollment_logs,&#10;  moderation_logs, payment_logs&#10;added (5): payment_events, coupon_redemptions,&#10;  payouts, notification_campaigns, stats_daily&#10;fixes: typed schemas, integer cents, real&#10;  counters + rollups, working chapter workflow,&#10;  working chat unread, idempotent payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="520" height="240" as="geometry"/></mxCell><mxCell id="cv_index" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;File Index (pages)&lt;/b&gt;&amp;#10;p2  domain map - contexts &amp; connections&#10;p3  FULL ER DIAGRAM - all 26 collections,&#10;    fields, indexes, 38 relations&#10;p4  analytics pipeline - how admin and&#10;    instructor dashboards get their data&#10;p5  core flows - purchase, auth, workflow,&#10;    chat unread, certificates&#10;p6  retention + integrity + security rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1100" y="140" width="540" height="240" as="geometry"/></mxCell><mxCell id="cv_ch0" value="Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="90" y="470" width="132" height="38" as="geometry"/></mxCell><mxCell id="cv_ch1" value="Catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="232" y="470" width="132" height="38" as="geometry"/></mxCell><mxCell id="cv_ch2" value="Learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="374" y="470" width="132" height="38" as="geometry"/></mxCell><mxCell id="cv_ch3" value="Commerce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="516" y="470" width="132" height="38" as="geometry"/></mxCell><mxCell id="cv_ch4" value="Communication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="658" y="470" width="132" height="38" as="geometry"/></mxCell><mxCell id="cv_ch5" value="Ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#94A3B8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="132" height="38" as="geometry"/></mxCell><mxCell id="cv_ch6" value="Analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#22D3EE;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="942" y="470" width="132" height="38" as="geometry"/></mxCell><mxCell id="cv_marks" value="markers   UQ unique index  -  IX secondary index&#10;          TTL auto-expiry  -  CNT maintained counter ($inc)&#10;          ? optional field  -  -&gt; reference to a collection&#10;edges     1 --&lt; many (crow’s foot)   -   dashed = roll-up / derived flow&#10;money     integer minor units only (*_cents)  -  server computed&#10;ids       ObjectId (Mongo-native)  -  exposed as &quot;id&quot; string in DTOs&#10;schema    typed everywhere  -  no Mixed except settings.value&#10;safety    role / quiz answers / password guarded by repo projections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="990" height="190" as="geometry"/></mxCell><mxCell id="cv_principles" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Design Principles (the law of this redesign)&lt;/b&gt;&amp;#10;1.  model for access patterns - every index serves a named query&#10;2.  embed what is bounded and read together; reference what is unbounded&#10;3.  one source of truth per fact - denormalization is owned + rebuildable&#10;4.  no Mixed except settings.value - progress, questions, answers typed&#10;5.  money is integer minor units - computed server-side only&#10;6.  financial records are append-only - state changes, never edits&#10;7.  every reference is an ObjectId, one direction - no bidirectional dupes&#10;8.  transactions only for cross-collection invariants&#10;9.  counters updated with atomic operators in the write path ($inc)&#10;10. dashboards read stats_daily rollups - raw scans are banned&#10;11. retention is a schema decision - every log declares TTL or archival&#10;12. schema-level security - role/answers/password only via dedicated methods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="1580" height="330" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="p2-domain" name="2. Domain Map">
