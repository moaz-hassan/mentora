<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dm_banner" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;MENTORA DATA PLATFORM — Domain Map&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;7 domains · 26 collections · how the contexts connect · dashed = derived / roll-up data flow&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="2154" height="80" as="geometry"/></mxCell><mxCell id="dm_identity" value="&lt;b style='color:#38BDF8;font-size:13px;'&gt;IDENTITY&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#38BDF8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="486" height="202" as="geometry"/></mxCell><mxCell id="dm_catalog" value="&lt;b style='color:#34D399;font-size:13px;'&gt;CATALOG&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#34D399;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="616" y="140" width="486" height="202" as="geometry"/></mxCell><mxCell id="dm_learning" value="&lt;b style='color:#FBBF24;font-size:13px;'&gt;LEARNING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#FBBF24;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1172" y="140" width="486" height="202" as="geometry"/></mxCell><mxCell id="dm_commerce" value="&lt;b style='color:#FB923C;font-size:13px;'&gt;COMMERCE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#FB923C;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1728" y="140" width="486" height="202" as="geometry"/></mxCell><mxCell id="dm_comm" value="&lt;b style='color:#A78BFA;font-size:13px;'&gt;COMMUNICATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#A78BFA;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="432" width="486" height="360" as="geometry"/></mxCell><mxCell id="dm_ops" value="&lt;b style='color:#94A3B8;font-size:13px;'&gt;OPS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#94A3B8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="616" y="432" width="486" height="360" as="geometry"/></mxCell><mxCell id="dm_analytics" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;ANALYTICS (read model)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1172" y="432" width="486" height="360" as="geometry"/></mxCell><mxCell id="dm_identity_c0" value="users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="86" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_identity_c1" value="auth_tokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="310" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_catalog_c0" value="courses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="642" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_catalog_c1" value="categories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="866" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_catalog_c2" value="campaigns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="642" y="240" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_catalog_c3" value="lesson_materials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="866" y="240" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_catalog_c4" value="quizzes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="642" y="290" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_learning_c0" value="enrollments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1198" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_learning_c1" value="quiz_results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1422" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_learning_c2" value="ratings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1198" y="240" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_learning_c3" value="certificates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1422" y="240" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_commerce_c0" value="payments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1754" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_commerce_c1" value="payment_events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1978" y="190" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_commerce_c2" value="coupons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1754" y="240" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_commerce_c3" value="coupon_redemptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1978" y="240" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_commerce_c4" value="payouts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1754" y="290" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_comm_c0" value="chat_rooms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="86" y="482" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_comm_c1" value="chat_participants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="310" y="482" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_comm_c2" value="chat_messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="86" y="532" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_comm_c3" value="notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="310" y="532" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_comm_c4" value="notification_campaigns" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="86" y="582" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_ops_c0" value="audit_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#94A3B8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="642" y="482" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_ops_c1" value="error_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#94A3B8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="866" y="482" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_ops_c2" value="reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#94A3B8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="642" y="532" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_ops_c3" value="settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#94A3B8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="866" y="532" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_analytics_c0" value="stats_daily" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#22D3EE;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="1198" y="482" width="210" height="36" as="geometry"/></mxCell><mxCell id="dm_afooter" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;rollup scopes&lt;/b&gt;&amp;#10;platform  -  one row per day&#10;instructor -  per instructor per day&#10;course     -  per course per day&#10;&#10;written by nightly $merge job&#10;(idempotent, rebuildable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1198" y="532" width="434" height="150" as="geometry"/></mxCell><mxCell id="dm_integrations" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;External Integrations&lt;/b&gt;&amp;#10;next.js client  -&gt;  all contexts (REST)&#10;socket.io       -&gt;  communication (WSS)&#10;stripe          -&gt;  commerce (webhooks)&#10;supabase        -&gt;  catalog (materials)&#10;cloudinary      -&gt;  catalog (video / HLS)&#10;gemini          -&gt;  catalog.ai_review&#10;cron + bull     -&gt;  analytics, notifications&#10;redis cache     -&gt;  settings, hot reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1728" y="432" width="434" height="360" as="geometry"/></mxCell><mxCell id="f1" value="instructors author" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dm_identity" target="dm_catalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="students learn" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArr