="courses" target="coupon_redemptions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed13" value="quiz_id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="quizzes" target="quiz_results"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed14" value="fulfills (payment_id?)" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="payments" target="enrollments"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed15" value="completion -&gt; issue" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;dashed=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0.6666666666666666;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="enrollments" target="certificates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed16" value="adds member" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1;dashed=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0.3333333333333333;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="enrollments" target="chat_participants"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed17" value="payment_id?" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="payments" target="payment_events"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed18" value="payout_id? (settlement)" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERzeroToMany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="payouts" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed19" value="coupon_id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6666666666666666;entryDx=0;entryDy=0;" edge="1" parent="1" source="coupons" target="coupon_redemptions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1a" value="payment_id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0;exitY=0.3333333333333333;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="coupon_redemptions" target="payments"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1b" value="room_id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="chat_rooms" target="chat_messages"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1c" value="room_id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="chat_rooms" target="chat_participants"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1d" value="campaign_id?" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0;exitY=0.6666666666666666;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="notification_campaigns" target="notifications"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1e" value="scope=course (rollup)" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#475569;strokeWidth=1;dashed=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.2222222222222222;exitDx=0;exitDy=0;entryX=0;entryY=0.6666666666666666;entryDx=0;entryDy=0;" edge="1" parent="1" source="courses" target="stats_daily"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1f" value="scope=instructor (rollup)" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#475569;strokeWidth=1;dashed=1;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.18181818181818182;exitDx=0;exitDy=0;entryX=0;entryY=0.3333333333333333;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="stats_daily"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="p4-analytics" name="4. Analytics Pipeline">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1220" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="an_banner" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;ANALYTICS PIPELINE — How Admin &amp; Instructor Dashboards Get Their Data&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;real-time counters · nightly $merge rollups (stats_daily) · live indexed reads · zero raw scans, zero N+1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="80" as="geometry"/></mxCell><mxCell id="pb0" value="&lt;b style='color:#FBBF24;font-size:13px;'&gt;BAND 1 — REAL-TIME COUNTERS  (updated in the same write path — instant)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#FBBF24;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="1880" height="190" as="geometry"/></mxCell><mxCell id="pb1" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;BAND 2 — DAILY ROLLUPS — stats_daily  (nightly $merge + hourly refresh for today)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="1880" height="430" as="geometry"/></mxCell><mxCell id="pb2" value="&lt;b style='color:#38BDF8;font-size:13px;'&gt;BAND 3 — DASHBOARD READS  (every query index-backed; transactions and payouts always live)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#38BDF8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1880" height="330" as="geometry"/></mxCell><mxCell id="an_a1" value="Enrollment created / rating written /&#10;progress saved (fact + counter, one path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="215" width="380" height="58" as="geometry"/></mxCell><mxCell id="an_a2" value="courses.stats / users.stats&#10;atomic $inc — never recomputed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="560" y="215" width="340" height="58" as="geometry"/></mxCell><mxCell id="an_a3" value="Course cards · instructor course lists ·&#10;rating average — one indexed read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="980" y="215" width="420" height="58" as="geometry"/></mxCell><mxCell id="an_a4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Counter Safety&lt;/b&gt;&amp;#10;rebuildable:  npm run counters:rebuild&#10;values always reproducible from sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1480" y="212" width="400" height="64" as="geometry"/></mxCell><mxCell id="f1g" value="atomic $inc" style="html=1;rounded=0;strokeColor=#FBBF24;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="an_a1" target="an_a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1h" value="indexed read" style="html=1;rounded=0;strokeColor=#FBBF24;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="an_a2" target="an_a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="an_b1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Source Collections&lt;/b&gt;&amp;#10;users  courses  enrollments&#10;quiz_results  ratings  payments&#10;payment_events  certificates&#10;chat_messages  auth_tokens (logins)&#10;&#10;authoritative sources stay the&#10;single truth — rollups are cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="440" width="400" height="160" as="geometry"/></mxCell><mxCell id="an_b2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Rollup Job (one writer)&lt;/b&gt;&amp;#10;Bull repeatable job&#10;  00:30 UTC nightly + hourly today&#10;aggregate per scope -&gt; $merge upsert&#10;idempotent: re-runs write the same&#10;rows (UQ scope + date + ref_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="420" height="160" as="geometry"/></mxCell><mxCell id="an_b3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;stats_daily (the read model)&lt;/b&gt;&amp;#10;scope: platform | instructor | course&#10;daily metrics (summable over ranges):&#10;  revenue_cents, transactions, enrollments,&#10;  completions, ratings, watch_seconds ...&#10;snapshots (latest in range):  users_total,&#10;  students_total, revenue_lifetime ...&#10;IX {scope, ref_id, date}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1040" y="440" width="500" height="160" as="geometry"/></mxCell><mxCell id="an_b4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Rebuild&lt;/b&gt;&amp;#10;npm run stats:rebuild&#10;    --from --to&#10;rows rebuilt from&#10;sources must match&#10;exactly (integrity&#10;tested in CI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="440" width="280" height="160" as="geometry"/></mxCell><mxCell id="an_b5" value="freshness:  today rows refreshed hourly (&lt;= 1h lag)  ·  yesterday and older finalized after the nightly job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="760" height="60" as="geometry"/></mxCell><mxCell id="an_b6" value="dashboards never scan raw collections — charts, trends and top-N read rollups only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="900" y="630" width="980" height="60" as="geometry"/></mxCell><mxCell id="f1i" value="aggregate" style="html=1;rounded=0;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="an_b1" target="an_b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1j" value="$merge upsert" style="html=1;rounded=0;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="an_b2" target="an_b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1k" value="rebuild" style="html=1;rounded=0;strokeColor=#22D3EE;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="an_b4" target="an_b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="an_d1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Admin Overview&lt;/b&gt;&amp;#10;totals: countDocuments w/ {role,status}&#10;trends: stats_daily (platform scope)&#10;pending reviews: {status: pending_review}&#10;recent activity: audit_logs {createdAt}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="915" width="420" height="215" as="geometry"/></mxCell><mxCell id="an_d2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Admin Financial&lt;/b&gt;&amp;#10;revenue breakdown: stats_daily (course&#10;  scope, grouped by ref_id in range)&#10;transactions: payments (paginated,&#10;  {status, createdAt} index)&#10;payouts: payouts + payments.payout_id&#10;refunds: refunded_total_cents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="560" y="915" width="420" height="215" as="geometry"/></mxCell><mxCell id="an_d3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Platform Analytics&lt;/b&gt;&amp;#10;enrollment trend: stats_daily&#10;top courses by revenue: rollups&#10;  grouped by ref_id, sorted top-N&#10;user growth / role mix: snapshots&#10;course performance: counters + rollups&#10;logs explorer: audit_logs, error_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1020" y="915" width="420" height="215" as="geometry"/></mxCell><mxCell id="an_d4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Instructor + Management&lt;/b&gt;&amp;#10;my courses: {instructor_id} + counters&#10;earnings: stats_daily (instructor scope)&#10;students list: enrollments&#10;  {course_id, createdAt desc} (paginated)&#10;ratings: {course_id, createdAt desc}&#10;engagement: rollups (watch, completions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1480" y="915" width="420" height="215" as="geometry"/></mxCell><mxCell id="f1l" value="rollups -&gt; every widget" style="html=1;rounded=0;strokeColor=#22D3EE;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="an_b3" target="an_d4"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="p5-flows" name="5. Core Flows">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1060" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="fl_banner" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;CORE DATA FLOWS — How the System Works on these Collections&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;purchase · auth · course lifecycle · chat unread · certificates — each box is a data-layer step&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="80" as="geometry"/></mxCell><mxCell id="st1m" value="&lt;b style='color:#FB923C;font-size:13px;'&gt;FLOW 1 — PURCHASE -&gt; ENROLLMENT  (one transaction)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#FB923C;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="1880" height="150" as="geometry"/></mxCell><mxCell id="br1s" value="session.withTransaction — atomic" style="rounded=1;html=1;fillColor=none;strokeColor=#F87171;strokeWidth=1.5;dashed=1;arcSize=4;align=center;verticalAlign=top;spacingTop=4;fontSize=9;fontColor=#F87171;" vertex="1" parent="1"><mxGeometry x="942" y="202" width="886" height="82" as="geometry"/></mxCell><mxCell id="st1t" value="&lt;b style='color:#38BDF8;font-size:13px;'&gt;FLOW 2 — AUTH &amp; SESSION LIFECYCLE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#38BDF8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="1880" height="150" as="geometry"/></mxCell><mxCell id="st1z" value="&lt;b style='color:#34D399;font-size:13px;'&gt;FLOW 3 — COURSE LIFECYCLE &amp; REVIEW  (the workflow that never worked before)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#34D399;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="1880" height="150" as="geometry"/></mxCell><mxCell id="st25" value="&lt;b style='color:#A78BFA;font-size:13px;'&gt;FLOW 4 — CHAT MESSAGE -&gt; UNREAD BADGE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#A78BFA;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="1880" height="150" as="geometry"/></mxCell><mxCell id="st2a" value="&lt;b style='color:#FBBF24;font-size:13px;'&gt;FLOW 5 — COMPLETION -&gt; CERTIFICATE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#FBBF24;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="1880" height="150" as="geometry"/></mxCell><mxCell id="sp140_n0" value="Client checkout&#10;(course_id +&#10;coupon code only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="210" width="220" height="58" as="geometry"/></mxCell><mxCell id="sp140_n1" value="payments {created}&#10;+ Stripe payment&#10;intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="220" height="58" as="geometry"/></mxCell><mxCell id="sp140_n2" value="Stripe webhook -&gt;&#10;payment_events&#10;(UQ idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="240" height="58" as="geometry"/></mxCell><mxCell id="sp140_n3" value="payments {succeeded}&#10;+ breakdown snapshot&#10;+ coupon claim $inc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="960" y="210" width="250" height="58" as="geometry"/></mxCell><mxCell id="sp140_n4" value="enrollments insert&#10;UQ (student + course)&#10;-&gt; access granted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1270" y="210" width="240" height="58" as="geometry"/></mxCell><mxCell id="sp140_n5" value="stats $inc + chat&#10;member + notification&#10;(queued email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1570" y="210" width="240" height="58" as="geometry"/></mxCell><mxCell id="f1n" value="intent" style="html=1;rounded=0;strokeColor=#FB923C;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp140_n0" target="sp140_n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1o" value="webhook" style="html=1;rounded=0;strokeColor=#FB923C;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp140_n1" target="sp140_n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1p" value="verify" style="html=1;rounded=0;strokeColor=#FB923C;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp140_n2" target="sp140_n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1q" value="fulfill" style="html=1;rounded=0;strokeColor=#FB923C;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp140_n3" target="sp140_n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1r" value="notify" style="html=1;rounded=0;strokeColor=#FB923C;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp140_n4" target="sp140_n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sp315_n0" value="Register — role&#10;FORCED = student" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="385" width="230" height="58" as="geometry"/></mxCell><mxCell id="sp315_n1" value="auth_tokens(verify):&#10;sha256, TTL 24h,&#10;attempts &lt;= 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="390" y="385" width="240" height="58" as="geometry"/></mxCell><mxCell id="sp315_n2" value="verify -&gt;&#10;email_verified_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="690" y="385" width="230" height="58" as="geometry"/></mxCell><mxCell id="sp315_n3" value="login: bcrypt +&#10;lockout rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="980" y="385" width="230" height="58" as="geometry"/></mxCell><mxCell id="sp315_n4" value="JWT { sub, &#10;token_version }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1270" y="385" width="230" height="58" as="geometry"/></mxCell><mxCell id="sp315_n5" value="pw change/reset -&gt;&#10;token_version++&#10;(ALL sessions revoked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1560" y="385" width="260" height="58" as="geometry"/></mxCell><mxCell id="f1u" value="issue" style="html=1;rounded=0;strokeColor=#38BDF8;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp315_n0" target="sp315_n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1v" value="email" style="html=1;rounded=0;strokeColor=#38BDF8;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp315_n1" target="sp315_n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1w" value="verified" style="html=1;rounded=0;strokeColor=#38BDF8;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp315_n2" target="sp315_n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1x" value="session" style="html=1;rounded=0;strokeColor=#38BDF8;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp315_n3" target="sp315_n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1y" value="revoke" style="html=1;rounded=0;strokeColor=#38BDF8;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sp315_n4" target="sp315_n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sp490_n0" value="instructor edits&#10;outline (draft)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="560" width="210" height="58" as="geometry"/></mxCell><mxCell id="sp490_n1" value="submit -&gt;&#10;pending_review&#10;(REAL fields)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="370" y="560" width="230" height="58" as="geometry"/></mxCell><mxCell id="sp490_n2" value="admin queue&#10;(indexed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="660" y="560" width="200" height="58" as="geometry"/></mxCell><mxCell id="sp490_n3" value="approve / reject&#10;+ reviewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="920" y="560" width="220" height="58" as="geometry"/></mxCell><mxCell id="sp490_n4" value="notify +&#10;audit_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1200" y="560" width="200" height="58" as="geometry"/></mxCell><mxCell id="sp490_n5" value="published -&gt;&#10;catalog + rollups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;