<diagram id="p6-rules" name="6. Rules &amp; Matrices">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1120" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ru_banner" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;RETENTION · INTEGRITY · SECURITY — The Rules Enforced by the Schema&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;TTL matrix, transaction map, uniqueness/idempotency, schema-level security — all decisions live in the model, not in service patches&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="80" as="geometry"/></mxCell><mxCell id="ru_r1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;RETENTION &amp; TTL MATRIX&lt;/b&gt;&amp;#10;auth_tokens        TTL expires_at (verify 24h / reset 30m)&#10;notifications      TTL expires_at  (read items -&gt; 180d)&#10;audit_logs         retention.expire_at per doc&#10;                     24m general  /  7y financial&#10;error_logs         TTL createdAt 90d&#10;payment_events     keep 7y (no TTL) — reconcile before purge&#10;stats_daily        keep forever (bounded size)&#10;payments / payouts NEVER deleted (financial records)&#10;all others         business lifetime; cascade on owner delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="900" height="430" as="geometry"/></mxCell><mxCell id="ru_r2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;TRANSACTION MAP (session.withTransaction)&lt;/b&gt;&amp;#10;purchase fulfillment   payments + payment_events +&#10;                       enrollments + courses.stats +&#10;                       coupons + coupon_redemptions&#10;certificate issue      certificates + enrollments.status&#10;                       + courses.stats&#10;payout processing      payouts + payments.payout_id&#10;role / status change   users + audit_logs&#10;gift / free enrollment enrollments + counters + chat member&#10;&#10;everything else: single-document atomic operations only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="940" height="430" as="geometry"/></mxCell><mxCell id="ru_r3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;UNIQUENESS &amp; IDEMPOTENCY&lt;/b&gt;&amp;#10;users.email                            UQ&#10;auth_tokens.token_hash                 UQ per purpose&#10;enrollments (student + course)         UQ&#10;ratings (student + course)             UQ&#10;certificates (student + course)        UQ   + serial UQ&#10;quiz_results (quiz + student + attempt)  UQ&#10;chat_participants (room + user)        UQ&#10;chat_rooms.course_id                   UQ sparse (one room)&#10;chat_rooms.participants_key            UQ sparse (no dup pairs)&#10;payments.provider_refs                 UQ sparse x2&#10;payment_events.provider_event_id       UQ (retries no-op)&#10;coupons.code                           UQ&#10;coupon_redemptions (coupon + user)     UQ&#10;stats_daily (scope + date + ref)       UQ&#10;settings.key  ·  categories.name        UQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="900" height="445" as="geometry"/></mxCell><mxCell id="ru_r4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;SCHEMA-LEVEL SECURITY RULES&lt;/b&gt;&amp;#10;role / status / password_hash / token_version&#10;  -&gt; dedicated repo methods only; public signup can&#10;     only ever produce role = student&#10;password_hash: select:false + stripped in toJSON&#10;correct_option_ids: never in student projections&#10;money: computed server-side (course price + coupon)&#10;reports: contact PII only for anonymous submissions&#10;every security event lands in audit_logs&#10;counters are never used for access decisions&#10;paywall = enrollment document, checked in transaction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="600" width="940" height="445" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
</mxfile>
