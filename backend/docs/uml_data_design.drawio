<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cv_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Mentora — Data Design in UML&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;26 collections · 7 embedded structures · UML class notation · companion to MONGODB_REDESIGN.md&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1880" height="104" as="geometry"/></mxCell><mxCell id="cv_p1" value="&lt;b style='color:#38BDF8;font-size:13px;'&gt;DOCUMENT MAP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#38BDF8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="880" height="430" as="geometry"/></mxCell><mxCell id="cv_n1" value="P1  Cover &amp; UML legend                 (this page)&#10;P2  Master class map — all 26 collections&#10;&#10;DOMAIN CLASS DIAGRAMS (UML)&#10;P3  Identity         users · auth_tokens + profile · security&#10;P4  Catalog          courses · chapters · lessons · quizzes ...&#10;P5  Learning         enrollments · progress · quiz_results ...&#10;P6  Commerce         payments · payment_events · coupons · payouts&#10;P7  Communication    chat_rooms/participants/messages · notifications&#10;P8  Ops              settings · audit_logs · error_logs · reports&#10;P9  Analytics        stats_daily — generation + consumers&#10;&#10;MODULE DATA PROCESS  (request -&gt; data -&gt; client)&#10;P10 Auth, Authorization &amp; Users       P14 Admin &amp; Settings&#10;P11 Chat &amp; Sockets                    P15 Notifications &amp; Background&#10;P12 Courses &amp; Content                 P16 Reports &amp; Analytics&#10;P13 Media &amp; Storage                   P17 AI&#10;                                      P18 Payments &amp; Enrollment" style="ro