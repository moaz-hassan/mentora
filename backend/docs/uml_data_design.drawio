lAlign=middle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4u_courses" target="p4st_users"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em2h" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed2g"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="em2i" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed2g"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="p4_np" value="&lt;b style='color:#34D399;font-size:13px;'&gt;CATALOG RULES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#34D399;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="920" height="300" as="geometry"/></mxCell><mxCell id="p4_n" value="COURSES — aggregate root; outline embedded (DP-02):&#10;  chapters[] -&gt; lessons[] · ≤100 lessons · content ≤100KB&#10;  per lesson (DP-20) — the doc stays small and cacheable.&#10;CHAPTER WORKFLOW — now REAL fields (fixes the dead review):&#10;  draft → pending_review → approved | rejected(+reason).&#10;QUIZZES — separate collection is a security rule: answer keys&#10;  never travel with course documents; student reads use the&#10;  findForStudent() projection only.&#10;INDEXES — text(title, subtitle, description) · {status,&#10;  category_id, price} · {instructor_id, createdAt} ·&#10;  popular {status, stats.enrollment_count} · embedded lesson&#10;  lookup {&quot;chapters.lessons._id&quot;}.&#10;COUNTERS — stats.* {CNT} via atomic $inc only; rebuild script." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="90" y="930" width="860" height="240" as="geometry"/></mxCell><mxCell id="p4_wp" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;WORKFLOW &amp; CURATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1000" y="880" width="940" height="300" as="geometry"/></mxCell><mxCell id="p4_w" value="CHAPTER REVIEW (designed endpoints):&#10;  instructor  POST /courses/:id/chapters/:cid/submit&#10;  admin       POST .../approve  |  .../reject + reason&#10;  every decision -&gt; audit_logs(category=moderation).&#10;&#10;DELETE GUARD — subcategory with courses is blocked by an&#10;indexed lookup on courses.subcategory_id.&#10;&#10;CAMPAIGNS — one source of &quot;featured&quot; (kind=banner|featured);&#10;ordered course_ids ≤50; homepage = 1 campaign read + $in read.&#10;&#10;LESSON PREVIEW — is_preview lessons stream without enrollment&#10;(signed URL issued by the media module after authz check)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1030" y="930" width="880" height="240" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
