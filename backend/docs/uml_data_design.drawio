e=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed4v"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="ed4y" value="target.id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=none;endArrow=none;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;verticalAlign=middle;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p8u_reports" target="p8st_courses"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em4z" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed4y"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="em50" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed4y"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="p8_ap" value="&lt;b style='color:#94A3B8;font-size:13px;'&gt;AUDIT TRAIL — ONE COLLECTION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#94A3B8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="920" height="340" as="geometry"/></mxCell><mxCell id="p8_a" value="ONE trail — admin actions + moderation + security + system&#10;(replaces audit_logs + moderation_logs + enrollment_logs drift).&#10;&#10;canonical before/after diff (fixes defect #4):&#10;  before {status:&quot;pending_review&quot;}  after {status:&quot;approved&quot;}&#10;&#10;categories: admin | moderation | security | system  {IX}&#10;required security events: login success/failure, password&#10;reset/change, email verify, role change, admin status toggle,&#10;coupon + payout operations.&#10;&#10;RETENTION — per doc retention.expire_at TTL: general 24m ·&#10;financial 7y (DP-15).&#10;Query indexes: {actor_id, createdAt} ·&#10;{target.type, target.id, createdAt} · {category, createdAt} ·&#10;{action, createdAt}.&#10;&#10;WRITE — auditService.record() from services only, never models." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="90" y="670" width="860" height="270" as="geometry"/></mxCell><mxCell id="p8_sp" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;SETTINGS · ERROR LOGS · REPORTS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1000" y="620" width="940" height="340" as="geometry"/></mxCell><mxCell id="p8_s" value="SETTINGS — key {UQ}; the one sanctioned Mixed value{} typed via&#10;data_type; category {IX}; is_public decides what unauthenticated&#10;clients can read (GET /api/settings/public). Cached in Redis,&#10;invalidated on write — hot reads never hit Mongo.&#10;&#10;ERROR LOGS — level, message, stack, context{request_id,&#10;endpoint, method, user_id, ip}; TTL 90d; {createdAt desc} and&#10;{context.request_id} indexes.&#10;&#10;REPORTS — anonymous reporters allowed (contact kept only then);&#10;target typed {Course|Lesson|Quiz|User}; workflow: pending -&gt;&#10;in_review -&gt; resolved | dismissed; notes[] append-only;&#10;ai {category, severity, summary} filled by the AI module (P17);&#10;resolution keeps resolved_by + resolved_at. Indexes: {status,&#10;priority, createdAt} · {target.type, target.id} · {reporter.user_id}." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1030" y="670" width="880" height="270" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
