width="240" height="19" as="geometry"/></mxCell><mxCell id="cvu_demo_r2" value="&lt;span style='color:#E3C567'&gt;{UQ}&lt;/span&gt; / &lt;span style='color:#E3C567'&gt;{IX}&lt;/span&gt; / &lt;span style='color:#E3C567'&gt;{TTL}&lt;/span&gt; marks" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;" vertex="1" parent="cvu_demo"><mxGeometry x="0" y="78" width="240" height="19" as="geometry"/></mxCell><mxCell id="cvu_demoe" value="&lt;span style='font-size:8px;color:#8FA3BF;'&gt;&amp;#171;embedded&amp;#187;&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:12px;'&gt;demoe&lt;/b&gt;" style="swimlane;html=1;fontSize=11;fontColor=#34D399;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#101B36;swimlaneFillColor=#16223D;strokeColor=#34D399;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1340" y="245" width="200" height="65" as="geometry"/></mxCell><mxCell id="cvu_demoe_r0" value="sub_field : int" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;" vertex="1" parent="cvu_demoe"><mxGeometry x="0" y="40" width="200" height="19" as="geometry"/></mxCell><mxCell id="cvst_demostub" value="&lt;span style='font-size:8px;color:#64748B;'&gt;&amp;#171;ref&amp;#187;&lt;/span&gt; &lt;b&gt;target_collection&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;strokeWidth=1;fontSize=10;fontColor=#94A3B8;" vertex="1" parent="1"><mxGeometry x="1340" y="430" width="145.6" height="34" as="geometry"/></mxCell><mxCell id="ed1" value="items[]" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#AFC0D8;strokeWidth=1.25;startArrow=diamond;startFill=1;startSize=14;endArrow=none;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;verticalAlign=middle;exitX=1;exitY=0.3333333333333333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cvu_demo" target="cvu_demoe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em2" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed1"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="em3" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed1"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="ed4" value="ref_id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=none;endArrow=none;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;verticalAlign=middle;exitX=1;exitY=0.6666666666666666;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cvu_demo" target="cvst_demostub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em5" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed4"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="em6" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed4"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="cv_n2" value="«collection»  — one MongoDB collection&#10;«embedded»    — doc structure inside its parent&#10;«ref»         — referenced collection (stub)&#10;&#10;1 -------- 0..*    association (FK field)&#10;  label = field name · line ends = multiplicities&#10;1 &lt;&gt;------ 0..*    composition (embedded)&#10;--- dashed, open arrow = «derive» rollup&#10;&#10;blue row       field referencing another class&#10;{UQ}{IX}{TTL}{CNT}  unique / index / TTL / counter&#10;bold row       compound unique constraint&#10;&#10;Money: integer *_cents, server-computed.&#10;IDs: ObjectId stored; DTO id string (DP-01).&#10;Full index specs: MONGODB_REDESIGN.md §4." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1560" y="245" width="360" height="340" as="geometry"/></mxCell><mxCell id="cv_p3" value="&lt;b style='color:#A78BFA;font-size:13px;'&gt;DOMAIN COLORS &amp; COUNTS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#A78BFA;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="880" height="300" as="geometry"/></mxCell><mxCell id="cv_ch0" value="Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="360" height="44" as="geometry"/></mxCell><mxCell id="cv_ch1" value="Catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#34D399;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="100" y="756" width="360" height="44" as="geometry"/></mxCell><mxCell id="cv_ch2" value="Learning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FBBF24;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="100" y="812" width="360" height="44" as="geometry"/></mxCell><mxCell id="cv_ch3" value="Commerce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#FB923C;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="100" y="868" width="360" height="44" as="geometry"/></mxCell><mxCell id="cv_ch4" value="Communication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="360" height="44" as="geometry"/></mxCell><mxCell id="cv_ch5" value="Ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#94A3B8;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="500" y="756" width="360" height="44" as="geometry"/></mxCell><mxCell id="cv_ch6" value="Analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#22D3EE;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="500" y="812" width="360" height="44" as="geometry"/></mxCell><mxCell id="cv_cht" value="TOTAL — 26 collections · 7 embedded structures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#F8FAFC;fontSize=10;fontColor=#D7E0EE;arcSize=30;" vertex="1" parent="1"><mxGeometry x="100" y="890" width="760" height="40" as="geometry"/></mxCell><mxCell id="cv_p4" value="&lt;b style='color:#94A3B8;font-size:13px;'&gt;READING RULES &amp; STATUS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#94A3B8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="980" y="640" width="960" height="300" as="geometry"/></mxCell><mxCell id="cv_n3" value="STATUS — design awaiting approval of DP-01 … DP-20&#10;(MONGODB_REDESIGN.md §9). No code before approval.&#10;&#10;1. Every box is a real collection or embedded structure.&#10;2. Relations are repository-known links — services never&#10;   ad-hoc join collections. Denormalized counters {CNT}.&#10;3. The blue row carries the FK; multiplicities sit on the&#10;   line ends and the field name is the edge label.&#10;4. Embedded bounds are fixed: ≤100 lessons · ≤100KB content&#10;   · campaigns ≤50 courses · ≤6 options per question.&#10;5. Inline marks highlight KEY indexes only — the full&#10;   per-collection index list lives in MONGODB_REDESIGN.md §4." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="920" height="230" as="geometry"/></mxCell><mxCell id="cv_n4" value="Generated: drawio-gen (uml) · rendering: app.diagrams.net — dark theme · source of truth: backend/docs/MONGODB_REDESIGN.md (§4 catalog · §6 dashboards · §9 decisions)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="965" width="1880" height="60" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
