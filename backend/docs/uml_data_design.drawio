<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="960" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Analytics — stats_daily: the dashboard read model&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;one doc per day per scope · nightly $merge + hourly today · disposible, rebuildable cache over the source collections&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="p9u_stats_daily" value="&lt;span style='font-size:8px;color:#8FA3BF;'&gt;&amp;#171;collection&amp;#187;&lt;/span&gt;&lt;br/&gt;&lt;b style='font-size:12px;'&gt;stats_daily&lt;/b&gt;" style="swimlane;html=1;fontSize=11;fontColor=#22D3EE;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#101B36;swimlaneFillColor=#16223D;strokeColor=#22D3EE;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="340" height="312" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r0" value="_id : objectId" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="40" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r1" value="date : string (YYYY-MM-DD UTC)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="59" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r2" value="scope : enum(platform|instructor|course)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="78" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r3" value="ref_id : objectId?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="97" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r4" value="{scope, date, ref_id} unique" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;fontStyle=1;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="116" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r5" value="daily: new_users, logins, new_enrollments," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="135" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r6" value="daily: completions, new_certificates, ratings_count," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="154" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r7" value="daily: lessons_completed, quiz_attempts, watch_seconds," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="173" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r8" value="daily: chat_messages, transactions, discount_cents," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="192" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r9" value="daily: revenue_gross_cents, refunds_cents, revenue_net_cents," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="211" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r10" value="snapshot: users_total, courses_approved_total," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="230" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r11" value="snapshot: enrollments_total, revenue_lifetime_cents," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="249" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r12" value="snapshot: students_total (instructor scope)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#8FA3BF;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="268" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9u_stats_daily_r13" value="generated_at : date" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[];portConstraint=eastwest;fontSize=10;fontColor=#D7E0EE;" vertex="1" parent="p9u_stats_daily"><mxGeometry x="0" y="287" width="340" height="19" as="geometry"/></mxCell><mxCell id="p9_gp" value="&lt;b style='color:#38BDF8;font-size:13px;'&gt;GENERATION — WRITE PATH&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#38BDF8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="760" height="400" as="geometry"/></mxCell><mxCell id="p9_g" value="SCOPE ROWS — one doc per day per platform |&#10;instructor(IF) | course(C); unique {scope, date, ref_id},&#10;&#10;DAILY EVENTS (summable): new_users, logins,&#10;new_enrollments, completions, new_certificates,&#10;revenue_gross_cents, discount_cents, refunds_cents,&#10;revenue_net_cents, transactions, ratings_count/sum,&#10;lessons_completed, quiz_attempts, watch_seconds, chat_messages.&#10;SNAPSHOTS (end-of-day, take latest): users_total, courses_&#10;approved_total, enrollments_total, revenue_lifetime_cents,&#10;students_total (instructor scope, nightly distinct).&#10;&#10;WRITE — nightly Bull job 02:00 UTC per scope with $merge&#10;upserts (idempotent); hourly refresh of today. Rebuild:&#10;npm run stats:rebuild -- --from YYYY-MM-DD --to YYYY-MM-DD.&#10;Sources stay authoritative — stats_daily is rebuildable cache." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="490" y="190" width="700" height="330" as="geometry"/></mxCell><mxCell id="p9_cp" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;CONSUMERS — READ PATH&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1260" y="140" width="680" height="400" as="geometry"/></mxCell><mxCell id="p9_c" value="Served by dedicated repository reads:&#10;A1 GET /api/admin/analytics/overview   range $group&#10;A2 /revenue · A3 /users · A4 /enrollments&#10;A5 /courses  top lists by metrics desc&#10;I1 GET /api/instructor/:id/stats  scope=instructor&#10;F1 financial = payments {status, createdAt} +&#10;   payouts, cross-checked with stats_daily&#10;&#10;BANNED BY DESIGN: full-collection loads into&#10;Node, N+1 per-row loops, client-side aggregation.&#10;&#10;FRESHNESS: today &lt;=1h stale · history exact after&#10;02:30 UTC · snapshot fields carry generated_at.&#10;CACHE: 60s Redis on hot admin endpoints." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1290" y="190" width="620" height="330" as="geometry"/></mxCell><mxCell id="p9_fp" value="&lt;b style='color:#A78BFA;font-size:13px;'&gt;DATA FLOW — SOURCES TO CHARTS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#A78BFA;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="1880" height="300" as="geometry"/></mxCell><mxCell id="p9_f0" value="Sources&#10;payments · enrollments&#10;ratings · certificates&#10;chat_messages · watch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="700" width="300" height="110" as="geometry"/></mxCell><mxCell id="p9_f1" value="Bull job 02:00 UTC&#10;$merge upsert&#10;(idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="440" y="700" width="300" height="110" as="geometry"/></mxCell><mxCell id="p9_f2" value="stats_daily&#10;1 row / scope / day&#10;+ hourly today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="780" y="700" width="300" height="110" as="geometry"/></mxCell><mxCell id="p9_f3" value="Repository read&#10;range $sum / $group&#10;indexed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1120" y="700" width="300" height="110" as="geometry"/></mxCell><mxCell id="p9_f4" value="Dashboards&#10;admin · instructor&#10;financial · exports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1460" y="700" width="300" height="110" as="geometry"/></mxCell><mxCell id="p9_ff0" style="html=1;rounded=0;strokeColor=#6D28D9;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9_f0" target="p9_f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9_ff1" style="html=1;rounded=0;strokeColor=#6D28D9;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9_f1" target="p9_f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9_ff2" style="html=1;rounded=0;strokeColor=#6D28D9;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9_f2" target="p9_f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9_ff3" style="html=1;rounded=0;strokeColor=#6D28D9;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p9_f3" target="p9_f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p9_fn" value="stats_daily answers every chart; entity counters (users.stats, courses.stats) answer totals instantly; live indexed reads serve today deltas and drill-downs. Raw-collection scans are banned by design (§6 strategy tiers)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="1740" height="70" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m1" name="P10 · Module — Auth &amp; Users">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m1_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 1 — Auth, Authorization &amp; Users&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: users · auth_tokens · audit_logs   |   side effects: Bull mail · audit trail · Redis rate-limit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m1_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;login / register forms&#10;session cookie (JWT httpOnly)&#10;profile editor&#10;password reset pages&#10;lockout + rate-limit feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m1_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;auth.routes.js · users.routes.js&#10;express-validator body schemas&#10;authenticate: JWT verify +&#10;  token_version check&#10;rate limits on login/register&#10;authorize(admin) on user ops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m1_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;reads body / params&#10;no logic, no queries&#10;calls authService / userService&#10;wraps {success, message, data}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m1_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;register -&gt; bcrypt(&gt;=10) -&gt;&#10;  create -&gt; mail job&#10;login -&gt; verify -&gt; fail count /&#10;  lock -&gt; JWT(token_version)&#10;reset -&gt; sha256 token, one active&#10;profile update -&gt; sanitize bio&#10;role change -&gt; admin + audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m1_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;usersRepo.findByEmail(+hash)&#10;usersRepo.create / touchLogin&#10;authTokensRepo.replace(user,&#10;  purpose) — kills previous&#10;auditRepo.insert(security)&#10;DTO mapper: id string (DP-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m1_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;users {UQ email · profile ·&#10;  security · token_version}&#10;&#10;auth_tokens {TTL 24h/30m ·&#10;  sha256 · attempts &lt;= 5}&#10;&#10;audit_logs {category: security}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa51" value="HTTPS + cookie" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m1_c0" target="m1_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa52" value="validated" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m1_c1" target="m1_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa53" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m1_c2" target="m1_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa54" value="repo query" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m1_c3" target="m1_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa55" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m1_c4" target="m1_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m1_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m1_c5" target="m1_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m1_sp" value="&lt;b style='color:#38BDF8;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#38BDF8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m1_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull mail queue&lt;/b&gt;&amp;#10;verify / reset / lockout emails&#10;retries + dedupe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m1_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Audit trail&lt;/b&gt;&amp;#10;audit_logs(security) written&#10;on every auth event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="686" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m1_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Redis&lt;/b&gt;&amp;#10;rate-limit counters +&#10;lockout fast path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1272" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="fa56" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m1_c3" target="m1_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m1_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;POST /api/auth/register         POST /api/auth/login          POST /api/auth/logout&#10;GET  /api/auth/me                POST /api/auth/forgot-password   POST /api/auth/reset-password&#10;POST /api/auth/verify-email      POST /api/auth/resend-verification&#10;PATCH /api/users/profile         POST /api/users/become-instructor&#10;GET | PUT | DELETE /api/users/:id     (admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m1_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;password: bcrypt cost &gt;= 10, select:false — never appears in any DTO&#10;email: lowercase + trim BEFORE the unique check&#10;role / status: dedicated repository methods, never mass-assignment&#10;JWT payload carries token_version; mismatch = 401 (sessions die on reset)&#10;login_fail_count + locked_until transitions are audited&#10;deleted users are soft: status transition + session kill, kept in history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m2" name="P11 · Module — Chat &amp; Sockets">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m2_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 2 — Chat &amp; Sockets&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: chat_rooms · chat_participants · chat_messages · notifications   |   side effects: socket.io · Bull digest · audit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m2_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;course group chat panel&#10;unread badges (maintained)&#10;typing indicator&#10;message composer + files&#10;cursor-scroll history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m2_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;chat.routes.js (REST)&#10;authenticate (cookie JWT)&#10;socket.io JWT handshake&#10;membership guard per room&#10;validators: body &lt;= 4000 chars&#10;rate limit sends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m2_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;REST: list rooms / messages&#10;send / mark-read&#10;socket handlers stay thin&#10;bridge to chatService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m2_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;sendMessage (single write path):&#10;  1 insert chat_messages&#10;  2 set rooms.last_message&#10;  3 participants $inc unread&#10;  4 emit message:new + badge&#10;markRead: unread=0 + cursor&#10;createRoom: participants_key UQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m2_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;roomsRepo.forUser(user_id)&#10;messagesRepo.page({room_id,&#10;  _id &lt; cursor})&#10;participantsRepo.bumpUnread&#10;participantsRepo.clearUnread&#10;notify(userIds, ...) helper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m2_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;chat_rooms {course UQ sparse ·&#10;  last_message denormalized}&#10;chat_participants {UQ room+user ·&#10;  unread_count {CNT}}&#10;chat_messages {cursor page ·&#10;  soft delete}&#10;notifications (system refs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa57" value="REST + socket" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m2_c0" target="m2_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa58" value="membership guard" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m2_c1" target="m2_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa59" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m2_c2" target="m2_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5a" value="repo query" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m2_c3" target="m2_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5b" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m2_c4" target="m2_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m2_c5" target="m2_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m2_sp" value="&lt;b style='color:#A78BFA;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#A78BFA;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m2_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Socket.io&lt;/b&gt;&amp;#10;message:new · room:updated&#10;badge:unread per user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m2_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull digest&lt;/b&gt;&amp;#10;offline email digests&#10;debounced per room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="686" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m2_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Audit&lt;/b&gt;&amp;#10;moderation actions only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1272" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="fa5c" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m2_c3" target="m2_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;GET  /api/chat/rooms                          POST /api/chat/rooms&#10;GET  /api/chat/rooms/:id/messages?cursor=     POST /api/chat/rooms/:id/messages&#10;POST /api/chat/rooms/:id/read&#10;socket: join-room · message:send · typing:ping · leave-room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m2_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;unread_count maintained on write — never computed per read (defect #2 fix)&#10;cursor pagination by ObjectId ordering — no skip/limit scans&#10;chat_rooms.last_message denormalized: room list = one indexed read&#10;soft delete keeps moderation history; files live in media storage only&#10;private rooms unique via sorted participants_key; course rooms unique by course_id&#10;attachments[] store {url, mime, size} — paths only, never blobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m3" name="P12 · Module — Courses &amp; Content">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m3_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 3 — Courses &amp; Content (courses · chapters · lessons · quizzes · progress)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: courses (embedded outline) · quizzes · lesson_materials · enrollments.progress · certificates   |   side effects: notifications · Bull mail · cache&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m3_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;course builder (outline)&#10;chapter submit for review&#10;course page + curriculum&#10;quiz player + results&#10;progress bar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m3_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;courses / chapters / lessons /&#10;quizzes routes&#10;authenticate + authorize&#10;  (owner | admin)&#10;validators + sanitize description&#10;content size &lt;= 100KB guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m3_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;thin CRUD + workflow actions&#10;submit / approve / reject&#10;attempt submit -&gt; grade&#10;no branching logic here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m3_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;ownership + state machine:&#10;  draft -&gt; pending_review -&gt;&#10;  approved | rejected(reason)&#10;grading server-side (keys stay),&#10;progress: $addToSet lessons /&#10;  chapters, $inc watch seconds&#10;final lesson -&gt; completion tx:&#10;  status + certificate + notify&#10;  + stats $inc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m3_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;coursesRepo.findOutline()&#10;coursesRepo.incStats($inc)&#10;quizzesRepo.findForStudent()&#10;  strips correct_option_ids&#10;materialsRepo.cascadeDelete&#10;progressRepo.applyCompletion()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m3_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;courses {chapters[]-&gt;lessons[]}&#10;lesson_materials {storage paths}&#10;quizzes {questions[] hidden keys}&#10;enrollments.progress {typed}&#10;certificates {serial UQ}&#10;audit_logs(moderation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa5d" value="HTTPS + JWT" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m3_c0" target="m3_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5e" value="owner | admin" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m3_c1" target="m3_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5f" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m3_c2" target="m3_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5g" value="repo query" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m3_c3" target="m3_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5h" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m3_c4" target="m3_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m3_c5" target="m3_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m3_sp" value="&lt;b style='color:#34D399;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#34D399;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m3_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Notifications&lt;/b&gt;&amp;#10;approval / rejection events&#10;+ new enrollment events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m3_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull mail&lt;/b&gt;&amp;#10;review outcome emails&#10;certificate ready email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="540" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m3_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Audit&lt;/b&gt;&amp;#10;every review decision +&#10;publish / archive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="980" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m3_s3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Redis cache&lt;/b&gt;&amp;#10;course + curriculum reads&#10;invalidated on write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1420" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="fa5i" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m3_c3" target="m3_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;POST | GET /api/courses            GET /api/courses/:id            (public read: approved only)&#10;POST /api/courses/:id/chapters     POST /api/courses/:id/chapters/:cid/submit | approve | reject&#10;POST /api/courses/:id/chapters/:cid/lessons       PUT | DELETE /api/lessons/:id&#10;GET  /api/quizzes/:id (student view — keys stripped)      POST /api/quizzes/:id/attempts&#10;POST /api/lessons/:id/complete     GET /api/certificates/verify/:serial  (public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m3_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;chapter.status is a REAL field — the dead review workflow is gone (defect #1 fix)&#10;outline bounded: &lt;=100 lessons · lesson content &lt;=100KB (DP-20)&#10;answer keys never cross the repository boundary for student reads&#10;course stats $inc only in write paths + rebuild script (no recount loops)&#10;completion + certificate issue + notification = one transaction, idempotent by unique pairs&#10;rejection carries rejection_reason shown to the instructor; resubmit allowed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m4" name="P13 · Module — Media &amp; Storage">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m4_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 4 — Media &amp; Storage (Cloudinary video/images · Supabase files)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: courses.media · lesson_materials.storage · users.profile.avatar_url · certificates.storage   |   side effects: Cloudinary · Supabase · Bull cleanup&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m4_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;avatar uploader&#10;thumbnail upload&#10;intro video upload + progress&#10;lesson material upload&#10;HLS video player&#10;certificate download" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m4_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;upload routes&#10;authenticate + owner / admin&#10;multer memory limit: size + mime&#10;signed-url issuance guards&#10;no local disk writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m4_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;thin handlers:&#10;init / receive / finalize&#10;return provider refs + urls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m4_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;images -&gt; Cloudinary transform&#10;video -&gt; Cloudinary + HLS eager&#10;  (deterministic public_id)&#10;materials -&gt; Supabase path&#10;  scoped course / lesson&#10;short-TTL signed URLs for stream&#10;orphan cleanup -&gt; Bull on delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m4_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;coursesRepo.setMedia()&#10;materialsRepo.setStorage()&#10;usersRepo.setAvatar()&#10;certificatesRepo.setStorage()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m4_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;courses.media {thumbnail,&#10;  intro_video + hls_url}&#10;lesson_materials.storage {path,&#10;  public_id, url}&#10;users.profile.avatar_url&#10;certificates.storage.download_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa5j" value="multipart / init" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m4_c0" target="m4_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5k" value="size+mime guard" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m4_c1" target="m4_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5l" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m4_c2" target="m4_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5m" value="repo query" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m4_c3" target="m4_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5n" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m4_c4" target="m4_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m4_c5" target="m4_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m4_sp" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m4_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Cloudinary&lt;/b&gt;&amp;#10;image transform + video&#10;HLS packaging (eager)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m4_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Supabase&lt;/b&gt;&amp;#10;materials + certificate PDF&#10;object storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="540" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m4_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull cleanup&lt;/b&gt;&amp;#10;orphan delete on lesson /&#10;course removal (cascade)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="980" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m4_s3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Audit&lt;/b&gt;&amp;#10;destructive media actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1420" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="fa5o" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m4_c3" target="m4_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m4_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;POST /api/upload/avatar               POST /api/upload/course-thumbnail&#10;POST /api/courses/:id/intro-video     POST /api/lessons/:id/materials&#10;GET  /api/materials/:id/download      (signed, enrollment-checked)&#10;DELETE /api/materials/:id             (owner | admin — soft + provider cleanup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m4_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;only provider paths / ids are persisted — never blobs, never local disk&#10;mime + size validated BEFORE the provider call&#10;download: check enrollment (or is_preview) first, then sign short-TTL URL&#10;video playback uses the HLS url only — no raw mp4 links exposed&#10;deleting a lesson enqueues material cleanup via Bull (idempotent)&#10;certificate PDFs rebuilt on demand from certificate data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m5" name="P14 · Module — Admin &amp; Settings">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m5_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 5 — Admin &amp; Settings (platform control)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: settings · users · campaigns · audit_logs · error_logs · reports   |   side effects: Redis invalidation · audit · notifications&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m5_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;admin dashboard pages&#10;settings editor&#10;instructor management&#10;logs viewer&#10;moderation queue&#10;campaign manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m5_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;admin.routes.js&#10;authenticate + authorize(admin)&#10;validators on every mutation&#10;pagination params bounded&#10;export rate-limited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m5_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;thin readers / updaters&#10;filters passed as query DTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m5_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;settings get/set -&gt; Redis cache&#10;  + targeted invalidation&#10;instructor approve / deactivate&#10;  -&gt; status + notify + audit&#10;moderation: hide rating /&#10;  archive course (no hard delete)&#10;campaign curation (featured)&#10;logs query: filters + paging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m5_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;settingsRepo.byKey / upsert&#10;adminUsersRepo.list / filter&#10;auditRepo.query(filters)&#10;campaignsRepo.setActive()&#10;reportsRepo.queueCounts()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m5_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;settings {key UQ · is_public}&#10;users {role · status}&#10;campaigns {course_ids[]}&#10;audit_logs · error_logs&#10;reports {status queue}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa5p" value="HTTPS + admin JWT" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m5_c0" target="m5_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5q" value="authorize(admin)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m5_c1" target="m5_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5r" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m5_c2" target="m5_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5s" value="repo query" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m5_c3" target="m5_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5t" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m5_c4" target="m5_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m5_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m5_c5" target="m5_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m5_sp" value="&lt;b style='color:#94A3B8;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#94A3B8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m5_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Redis&lt;/b&gt;&amp;#10;settings + dashboard cache&#10;invalidated on write" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m5_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Audit&lt;/b&gt;&amp;#10;every admin mutation&#10;before / after diff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="540" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m5_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Notifications&lt;/b&gt;&amp;#10;instructor approved /&#10;deactivated events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="980" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m5_s3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull mail&lt;/b&gt;&amp;#10;status-change emails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1420" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="fa5u" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m5_c3" target="m5_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m5_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;GET | PUT /api/admin/settings        GET /api/admin/settings/public   (unauthenticated, is_public only)&#10;GET /api/admin/instructors            PATCH /api/admin/users/:id/status&#10;GET /api/admin/logs?type=audit|error&amp;page=     GET /api/admin/reports?status=&#10;POST /api/admin/reports/:id/resolve   POST /api/admin/campaigns&#10;GET /api/admin/campaigns/:id/metrics  PUT /api/admin/courses/:id/publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m5_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;every admin mutation records audit_logs (canonical before/after)&#10;is_public=false values never reach client DTOs&#10;status / role changes via explicit endpoints — no mass-assignment PATCH&#10;banned: hard deletes of users or courses — archive / soft only&#10;campaign metrics read from notifications {campaign_id, is_read} — no code counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m6" name="P15 · Module — Notifications &amp; Background">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m6_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 6 — Notifications &amp; Background (email · Bell · Bull workers · cron)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: notifications · notification_campaigns   |   side effects: Bull queues · SMTP · socket bell · cron jobs&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m6_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;bell dropdown + badge&#10;notifications page&#10;admin campaign composer&#10;email inbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m6_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;notifications.routes.js&#10;authenticate&#10;admin campaign routes&#10;validators: audience object&#10;schedule date in future" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m6_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;list + mark read&#10;campaign create / schedule /&#10;cancel / send-now&#10;no fan-out logic here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m6_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;notify() — single entry used&#10;  by every other module&#10;fan-out: resolve audience&#10;  {all | role | course} -&gt;&#10;  insertMany + Bull email jobs&#10;scheduler: {status, scheduled_at}&#10;  -&gt; sending -&gt; stats update&#10;TTL hygiene + dedupe per user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m6_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;notificationsRepo.inbox(user,&#10;  cursor) + unreadCount()&#10;notificationsRepo.markRead()&#10;campaignsRepo.due(now)&#10;campaignsRepo.bumpStats()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m6_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;notifications {is_read ·&#10;  channels{} · TTL expires_at}&#10;notification_campaigns {status&#10;  scheduled|sending|sent · stats}&#10;users / enrollments used to&#10;resolve audiences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa5v" value="HTTPS + JWT" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m6_c0" target="m6_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5w" value="admin | user" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m6_c1" target="m6_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5x" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m6_c2" target="m6_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5y" value="repo query" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m6_c3" target="m6_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa5z" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m6_c4" target="m6_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m6_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m6_c5" target="m6_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m6_sp" value="&lt;b style='color:#A78BFA;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#A78BFA;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m6_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull mail workers&lt;/b&gt;&amp;#10;per-recipient jobs, deduped&#10;retry with backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m6_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Socket bell&lt;/b&gt;&amp;#10;in_app delivery event to&#10;online recipients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="540" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m6_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Cron (repeatable)&lt;/b&gt;&amp;#10;scheduler poll + nightly&#10;stats rollup + cleanups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="980" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m6_s3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Audit&lt;/b&gt;&amp;#10;campaign sends + cancels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1420" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="fa60" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m6_c3" target="m6_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m6_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;GET  /api/notifications                    PATCH /api/notifications/:id/read&#10;POST /api/notifications/read-all&#10;POST /api/admin/campaigns                  POST /api/admin/campaigns/:id/send-now | cancel&#10;GET  /api/admin/campaigns/:id/metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m6_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;per-channel delivery status embedded on each notification doc&#10;campaign metrics from notifications {campaign_id, is_read} — never title matching (defect #5 fix)&#10;email jobs deduped per recipient; failures recorded in channels.email.error&#10;read items expire via TTL expires_at (DP-13) — inbox stays bounded&#10;scheduled sends are idempotent: status transitions guard double-send" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m7" name="P16 · Module — Reports &amp; Analytics">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m7_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 7 — Reports &amp; Analytics (admin · instructor · financial)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;reads: stats_daily (primary) · entity counters · payments · enrollments · ratings · certificates   |   side effects: Bull export job · Redis cache&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m7_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;admin dashboard charts&#10;instructor analytics tab&#10;financial page&#10;export buttons" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m7_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;analytics.routes.js&#10;instructor stats route&#10;authenticate + authorize&#10;  (admin | instructor + own id)&#10;range params validated (&lt;=366d)&#10;export rate-limited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m7_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;parse range -&gt; series DTO&#10;no aggregation code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m7_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;dashboardService tiers:&#10;1 counters (users.stats,&#10;  courses.stats) — instant totals&#10;2 stats_daily range $group&#10;3 live indexed reads for today&#10;financial: payments by {status,&#10;  createdAt} + payouts&#10;exports -&gt; Bull job -&gt; file -&gt;&#10;  notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m7_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;statsRepo.series(scope, ref,&#10;  from, to) + topLists()&#10;paymentsRepo.sumRange()&#10;enrollmentsRepo.countRange()&#10;counter reads via projections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m7_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;stats_daily {scope, date, ref}&#10;courses.stats / users.stats&#10;payments {status, createdAt}&#10;enrollments {course, createdAt}&#10;ratings · certificates&#10;reports {status} queue counts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa61" value="HTTPS + role" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m7_c0" target="m7_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa62" value="range validated" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m7_c1" target="m7_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa63" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m7_c2" target="m7_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa64" value="indexed reads" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m7_c3" target="m7_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa65" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m7_c4" target="m7_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m7_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m7_c5" target="m7_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m7_sp" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m7_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull export job&lt;/b&gt;&amp;#10;CSV / XLSX built async&#10;provider file + notify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m7_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Notifications&lt;/b&gt;&amp;#10;export ready + report&#10;resolution events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="686" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m7_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Redis cache&lt;/b&gt;&amp;#10;60s TTL hot admin&#10;endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1272" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="fa66" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m7_c3" target="m7_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m7_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;GET  /api/admin/analytics/overview     GET /api/admin/analytics/revenue&#10;GET  /api/admin/analytics/users        GET /api/admin/analytics/enrollments&#10;GET  /api/admin/analytics/courses      POST /api/admin/analytics/export&#10;GET  /api/instructor/:id/stats         GET /api/admin/financial/transactions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m7_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;banned by design: loading collections into Node, N+1 loops, client-side aggregation&#10;freshness documented: today &lt;= 1h stale · history exact after the 02:30 rollup&#10;money always integer cents; ranges validated before touching the repository&#10;snapshot metrics take the latest row in range; daily events are $summed&#10;exports run as Bull jobs (never inside the request) and are audit-logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m8" name="P17 · Module — AI (Gemini)">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m8_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 8 — AI (Gemini course review · report triage · assistant)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: courses.ai_review · reports.ai · audit_logs · settings (model config)   |   side effects: Gemini API · Bull retry · notifications&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m8_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;instructor AI review panel&#10;admin report triage hints&#10;assistant chat widget&#10;examples gallery (public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m8_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;ai.routes.js&#10;optionalAuth for public demos&#10;authenticate for course review&#10;per-user rate limit&#10;prompt size + token caps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m8_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;pass structured payload&#10;return scores object&#10;no prompt building here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m8_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;aiService: build prompt&#10;  (no PII, bounded size)&#10;call Gemini server-side&#10;parse structured JSON output&#10;courses -&gt; ai_review write +&#10;  notification to instructor&#10;reports -&gt; ai{category,severity,&#10;  summary}&#10;failures -&gt; status failed +&#10;  Bull retry (bounded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m8_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;coursesRepo.setAiReview()&#10;reportsRepo.setAi()&#10;auditRepo.insert(system)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m8_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;courses.ai_review {status,&#10;  scores{}, feedback}&#10;reports.ai {category, severity,&#10;  summary}&#10;settings {model config}&#10;audit_logs {category: system}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa67" value="HTTPS + JWT" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m8_c0" target="m8_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa68" value="rate limit + caps" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m8_c1" target="m8_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa69" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m8_c2" target="m8_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa6a" value="repo query" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m8_c3" target="m8_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa6b" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m8_c4" target="m8_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m8_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m8_c5" target="m8_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m8_sp" value="&lt;b style='color:#E879F9;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#E879F9;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m8_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Gemini API&lt;/b&gt;&amp;#10;outbound HTTPS only&#10;key lives in backend env" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m8_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull retry&lt;/b&gt;&amp;#10;bounded retries, then&#10;status=failed + audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="686" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="m8_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Notifications&lt;/b&gt;&amp;#10;review ready for&#10;the instructor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1272" y="630" width="566" height="120" as="geometry"/></mxCell><mxCell id="fa6c" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m8_c3" target="m8_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m8_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;POST /api/ai/course-review             POST /api/ai/analyze&#10;POST /api/ai/suggest                   POST /api/ai/chat        (assistant)&#10;GET  /api/ai/examples                  (public gallery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m8_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;API key is env-only and used server-side — never shipped to clients&#10;no student PII in prompts; course + report text only, size-capped&#10;timeouts + bounded retries; failures recorded, never silently dropped&#10;all AI outputs typed and validated before persistence&#10;ai_review stays hidden from student DTOs; latest review only (history later)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
</diagram>
<diagram id="m9" name="P18 · Module — Payments &amp; Enrollment">
<mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1130" background="#0B132B" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m9_b" value="&lt;b style='font-size:22px;color:#F8FAFC;'&gt;Module 9 — Payments &amp; Enrollment (Stripe · coupons · payouts)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px;color:#94A3B8;'&gt;collections: payments · payment_events · coupons · coupon_redemptions · payouts · enrollments · chat_participants   |   side effects: Stripe · Bull retry · receipts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#3B82F6;strokeWidth=2;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="1880" height="84" as="geometry"/></mxCell><mxCell id="m9_c0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;1 · Client (Next.js)&lt;/b&gt;&amp;#10;checkout page (Stripe.js)&#10;coupon input&#10;success / fail pages&#10;instructor earnings view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m9_c1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;2 · Route + middleware&lt;/b&gt;&amp;#10;payments.routes.js&#10;webhook: RAW body before&#10;  json parser + signature&#10;authenticate for checkout&#10;validators: course_id, code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m9_c2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;3 · Controller (thin)&lt;/b&gt;&amp;#10;create checkout session&#10;webhook -&gt; paymentService&#10;refund / payout admin calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m9_c3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;4 · Service (logic)&lt;/b&gt;&amp;#10;computeTotals server-side&#10;  (price + coupon claim)&#10;create payment(status=created)&#10;Stripe session -&gt; refs stored&#10;webhook succeeded (tx):&#10;  1 events insert {event_id} UQ&#10;  2 payment -&gt; succeeded&#10;  3 enrollment upsert&#10;  4 redemption insert {pair}&#10;  5 counters $inc + chat add&#10;  6 notification + receipt&#10;refunds append · payout: aggregate&#10;  + updateMany assign (tx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m9_c4" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;5 · Repository (data)&lt;/b&gt;&amp;#10;paymentsRepo.upsertByIntent()&#10;enrollmentsRepo.ensure()&#10;couponsRepo.claim()  (atomic)&#10;payoutsRepo.create + assign()&#10;redemptionsRepo.insert(pair)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1300" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="m9_c5" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;6 · MongoDB collections&lt;/b&gt;&amp;#10;payments {refs UQ sparse, cents}&#10;payment_events {provider_event&#10;  UQ — idempotency}&#10;coupon_redemptions {pair UQ}&#10;payouts {period, status}&#10;enrollments · chat_participants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1600" y="140" width="270" height="360" as="geometry"/></mxCell><mxCell id="fa6d" value="HTTPS + JWT / webhook" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m9_c0" target="m9_c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa6e" value="signature + validators" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m9_c1" target="m9_c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa6f" value="call" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m9_c2" target="m9_c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa6g" value="tx writes" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m9_c3" target="m9_c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fa6h" value="Mongo wire" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m9_c4" target="m9_c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m9_resp" value="response — { success, message, data } · DTO mapped (no hashes · money as int cents)" style="html=1;rounded=0;dashed=1;strokeColor=#22D3EE;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;fontSize=9;fontColor=#22D3EE;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m9_c5" target="m9_c0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="545"/></Array></mxGeometry></mxCell><mxCell id="m9_sp" value="&lt;b style='color:#FB923C;font-size:13px;'&gt;SIDE EFFECTS — ASYNC, NEVER BLOCKING THE RESPONSE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#FB923C;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1880" height="190" as="geometry"/></mxCell><mxCell id="m9_s0" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Stripe API&lt;/b&gt;&amp;#10;checkout sessions +&#10;refund calls (server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m9_s1" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull retry&lt;/b&gt;&amp;#10;failed webhook events&#10;re-processed idempotently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="540" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m9_s2" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Bull mail&lt;/b&gt;&amp;#10;receipts + payment&#10;failed notices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="980" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="m9_s3" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;Audit&lt;/b&gt;&amp;#10;financial retention 7y" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1420" y="630" width="420" height="120" as="geometry"/></mxCell><mxCell id="fa6i" value="fires (async)" style="html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;" edge="1" parent="1" source="m9_c3" target="m9_sp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m9_ep" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;ENDPOINTS — REST (+ socket where noted)&lt;/b&gt;&amp;#10;POST /api/payments/checkout            POST /api/webhooks/stripe        (raw + signature)&#10;GET  /api/payments/my                  POST /api/enrollments            (free / gift)&#10;POST /api/coupons/validate             GET  /api/instructor/earnings&#10;POST /api/admin/payments/:id/refund    POST /api/admin/payouts         (batch settle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="900" height="290" as="geometry"/></mxCell><mxCell id="m9_rl" value="&lt;b style='color:#E2E8F0;font-size:11px;'&gt;DATA RULES &amp; TRANSFORMATIONS&lt;/b&gt;&amp;#10;amounts never come from the client — totals computed server-side in cents&#10;webhook handled idempotently by provider_event_id {UQ} (replay-safe)&#10;one payment per Stripe intent: payment_intent_id / checkout_session_id UQ sparse&#10;coupon claim is race-free: findOneAndUpdate guard inside the transaction&#10;money fields immutable after succeeded — refunds are append-only compensation&#10;payout assignment: payments.updateMany({payout_id:null} in period) in one tx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1000" y="800" width="940" height="290" as="geometry"/></mxCell></root></mxGraphModel>
