" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="ed1j" value="security" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#AFC0D8;strokeWidth=1.25;startArrow=diamond;startFill=1;startSize=14;endArrow=none;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;verticalAlign=middle;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3u_users" target="p3u_security"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em1k" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed1j"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="em1l" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed1j"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="ed1m" value="user_id" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;strokeColor=#64748B;strokeWidth=1.25;startArrow=none;endArrow=none;fontSize=9;fontColor=#C4D2E6;labelBackgroundColor=#0B132B;verticalAlign=middle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3u_auth_tokens" target="p3u_users"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="em1n" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed1m"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="em1o" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=#0B132B;fontSize=9;fontColor=#8FA3BF;" vertex="1" connectable="0" parent="ed1m"><mxGeometry x="0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="p3_np" value="&lt;b style='color:#38BDF8;font-size:13px;'&gt;IDENTITY RULES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#38BDF8;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="1300" y="150" width="640" height="470" as="geometry"/></mxCell><mxCell id="p3_n" value="USERS — single source of identity (no profiles collection).&#10;· email lowercase + trimmed, unique; password bcrypt cost &gt;= 10,&#10;  select:false — never appears in any DTO (security rule).&#10;· role / status writable only through dedicated repository&#10;  methods (no mass-assignment) + audit_logs(category=security).&#10;· token_version bumped on password change / reset / deactivate&#10;  -&gt; every existing JWT dies. deleted = soft status transition.&#10;· indexes: email {UQ} · {role, status} {IX} · {createdAt}.&#10;&#10;AUTH_TOKENS — verify / reset / invite (single-use, hashed).&#10;· sha256 stored, never plaintext; attempts &lt;= 5 then invalidate.&#10;· new token of same purpose deletes previous ones (one active).&#10;· TTL expires_at: verify 24h · reset 30m (DP-08).&#10;&#10;EMBEDDED — profile (bio / links / expertise) · security (lock state).&#10;· lock: login_fail_count + locked_until after N failures (SEC-10).&#10;· growth: users M · auth_tokens S — TTL cleans itself." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="1320" y="200" width="600" height="410" as="geometry"/></mxCell><mxCell id="p3_jp" value="&lt;b style='color:#22D3EE;font-size:13px;'&gt;AUTH DATA JOURNEY — DESIGNED FLOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D1730;strokeColor=#22D3EE;strokeWidth=1;opacity=70;arcSize=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="1880" height="250" as="geometry"/></mxCell><mxCell id="p3_s0" value="1 · Register&#10;users + bcrypt hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="100" y="730" width="240" height="64" as="geometry"/></mxCell><mxCell id="p3_s1" value="2 · auth_tokens&#10;verify 24h {TTL}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="400" y="730" width="240" height="64" as="geometry"/></mxCell><mxCell id="p3_s2" value="3 · Verify email&#10;email_verified_at set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="700" y="730" width="240" height="64" as="geometry"/></mxCell><mxCell id="p3_s3" value="4 · Login&#10;fail count / lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1000" y="730" width="240" height="64" as="geometry"/></mxCell><mxCell id="p3_s4" value="5 · JWT issued&#10;token_version bound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1300" y="730" width="240" height="64" as="geometry"/></mxCell><mxCell id="p3_s5" value="6 · Session kill&#10;token_version bump" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16223D;strokeColor=#38BDF8;strokeWidth=1.5;fontSize=11;fontColor=#E2E8F0;arcSize=25;" vertex="1" parent="1"><mxGeometry x="1600" y="730" width="240" height="64" as="geometry"/></mxCell><mxCell id="p3_fl0" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_s0" target="p3_s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_fl1" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_s1" target="p3_s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_fl2" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_s2" target="p3_s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_fl3" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_s3" target="p3_s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_fl4" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_s4" target="p3_s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_jn" value="Every step writes audit_logs(category=security). Emails (verify / reset / lockout) are dispatched to the Bull mail queue — SMTP never blocks the request path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#101B36;strokeColor=#334155;strokeWidth=1;arcSize=4;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=10;fontFamily=Courier New;fontColor=#AFC0D8;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="1740" height="60" as="geometry"/></mxCell></root></mxGraphModel>
